# macOS/Linux 启动脚本必须是 LF —— 带 CRLF 时 bash 会因为 \r 直接报错,
# 双击 start.command 会打不开。Windows 上 checkout 也强制保持 LF。
*.command text eol=lf
*.sh      text eol=lf

# Windows 批处理反过来,必须 CRLF
*.bat     text eol=crlf

# 其余文本文件交给 git 自动处理
*.js      text
*.json    text
*.css     text
*.html    text
*.md      text
*.sql     text
